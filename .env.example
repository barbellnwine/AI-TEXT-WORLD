# Copy to .env and fill in. Never commit the real .env file.

# --- server ---
PORT=8787
# Hosting platforms require 0.0.0.0; local development defaults to loopback.
HOST=127.0.0.1
AI_COMMUNITY_DB_PATH=data/ai-community.sqlite
# Shared secret required to call any /api/ai-community/admin/* endpoint (x-admin-token header).
# Leave empty to disable admin endpoints entirely (fail-closed default).
AI_COMMUNITY_ADMIN_TOKEN=

# One-time boot seed for the first real ADMIN-role user (users/sessions tables, /api/auth/*).
# It runs only while no ADMIN exists. Use a 12+ character password, start once, then remove
# both values from the environment. Never commit real values.
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# --- providers (server-side only, never exposed to the browser / never use VITE_ prefix) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- master switches ---
# AI_COMMUNITY_ENABLED gates real (paid) provider calls only. DEMO mode ignores this flag,
# so the UI and scheduler are fully testable with both left at their defaults below.
AI_COMMUNITY_ENABLED=false
AI_COMMUNITY_DEMO_MODE=true
# World Builder + simulation. New seasons freeze this mode at START WORLD.
# true: deterministic movement/wait, no paid calls. false: real agent + rule judge calls.
AI_WORLD_DEMO_MODE=true
# WORLD CONSTITUTION: engine updates and AI decisions have independent schedules.
MAX_ACTIVE_CHARACTERS=10
WORLD_MINUTES_PER_TICK=1
WORLD_DECISIONS_PER_CYCLE=2
WORLD_DECISION_COOLDOWN_MS=30000
WORLD_CHAPTER_MINUTES=60
# Optional lifetime USD allowance for prepaid API credit. Does not reset monthly.
# Existing 20% safety margin applies; 20 USD stops new requests around 16 USD.
# AI_PROVIDER_PREPAID_BUDGET_USD=20
# Production only: set true after externally verifying hosting + provider hard limits.
# This flag records operator verification; it does not configure those accounts.
AI_COMMUNITY_PROVIDER_LIMITS_CONFIRMED=false

# --- combined OpenAI + Anthropic budget (KST calendar month + week) ---
# Railway's minimum Compute hard limit is $10 (~14,000 KRW @1400), not $5.
# Deployed value: 32,000 (API) + up to 14,000 (server, hard-capped) = 46,000,
# leaving extra headroom under the 50,000 KRW target and the 60,000 KRW ceiling.
AI_COMMUNITY_MONTHLY_BUDGET_KRW=32000
AI_COMMUNITY_WEEKLY_BUDGET_KRW=8000
AI_COMMUNITY_BUDGET_SAFETY_MARGIN=0.20
AI_COMMUNITY_BUDGET_TIMEZONE=Asia/Seoul
AI_COMMUNITY_WEEK_START_DAY=MONDAY
USD_TO_KRW_RATE=1400

# --- scheduling / call limits ---
AI_COMMUNITY_TICK_INTERVAL_MS=300000
AI_COMMUNITY_MAX_OUTPUT_TOKENS=400
AI_COMMUNITY_MAX_INPUT_TOKENS=2000
AI_COMMUNITY_REQUEST_TIMEOUT_MS=20000
AI_COMMUNITY_MAX_RETRIES=0
AI_COMMUNITY_COOLDOWN_MS=300000
