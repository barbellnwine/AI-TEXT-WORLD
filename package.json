{
  "name": "ai-amnesty-protocol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types server/index.ts",
    "build": "tsc -b && vite build && node tool/check-public-secrets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "node --experimental-strip-types --test tests/logic.test.ts tests/ai-community.test.ts tests/monthly-budget.test.ts tests/security.test.ts",
    "test:e2e": "playwright test",
    "start": "node --experimental-strip-types server/index.ts",
    "test:deployment": "node --experimental-strip-types --test tests/deployment.test.ts"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
