{
    "name":  "the-anomaly",
    "private":  true,
    "version":  "1.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1",
                    "server":  "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
                    "start":  "node --experimental-strip-types server/index.ts",
                    "build":  "tsc -b \u0026\u0026 vite build \u0026\u0026 node tool/check-public-secrets.mjs",
                    "typecheck":  "tsc -b \u0026\u0026 tsc -p tsconfig.server.json --noEmit",
                    "test":  "node --experimental-strip-types --test tests/anomaly.test.ts",
                    "preview":  "vite preview --host 127.0.0.1"
                },
    "dependencies":  {
                         "react":  "^19.1.0",
                         "react-dom":  "^19.1.0"
                     },
    "devDependencies":  {
                            "@playwright/test":  "^1.58.0",
                            "@types/node":  "^24.0.0",
                            "@types/react":  "^19.1.0",
                            "@types/react-dom":  "^19.1.0",
                            "@vitejs/plugin-react":  "^5.0.0",
                            "typescript":  "~5.9.2",
                            "vite":  "^7.1.0"
                        },
    "engines":  {
                    "node":  "\u003e=24 \u003c25"
                }
}
